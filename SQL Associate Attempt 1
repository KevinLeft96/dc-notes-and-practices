-- Task #1
SELECT
	id,
	location,
	COALESCE(total_rooms, 100) AS total_rooms,
	staff_count,
	CASE
		WHEN opening_date = '-' THEN '2023'
		ELSE opening_date
	END AS opening_date,
	CASE
		WHEN target_guests IN ('B', 'B.%', '%B.%','B.', '%B%', 'Busniess') THEN 'Business'
		ELSE target_guests
	END AS target_guests
FROM branch;


-- Task #2
SELECT
	service_id,
	branch_id,
	ROUND(AVG(time_taken::NUMERIC),2) AS avg_time_taken,
	MAX(time_taken) AS max_time_taken
FROM request
GROUP BY service_id, branch_id;


-- Task #3
SELECT
	s.description,
	b.id,
	b.location,
	r.id AS request_id,
	r.rating
FROM request AS r
LEFT JOIN branch AS b
	ON r.branch_id = b.id
LEFT JOIN service AS s
	ON s.id = r.service_id
WHERE s.description IN ('Meal', 'Laundry')
	AND b.location IN ('EMEA', 'LATAM');


-- Task #4
SELECT
	service_id,
	branch_id,
	ROUND(AVG(rating::NUMERIC), 2) AS avg_rating
FROM request
GROUP BY
	service_id,
	branch_id
HAVING AVG(rating::NUMERIC) < 4.5;
