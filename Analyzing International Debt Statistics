-- num_distinct_countries 

SELECT
	COUNT( DISTINCT country_name) AS total_distinct_countries
FROM international_debt

-- highest_debt_country 
SELECT
	country_name,
	SUM(debt:: numeric) AS total_debt
FROM international_debt
GROUP BY country_name
ORDER BY total_debt DESC
LIMIT 1

-- highest_debt_country 
SELECT
	country_name,
	SUM(debt:: numeric) AS total_debt
FROM international_debt
GROUP BY country_name
ORDER BY total_debt DESC
LIMIT 1
